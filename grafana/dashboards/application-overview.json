{
  "title": "TraceFlow Lite - Application Overview",
  "uid": "traceflow-app-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "tags": ["traceflow-lite"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_requests_seconds_count, service)",
        "current": { "text": "traceflow-demo", "value": "traceflow-demo" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    { "id": 1, "title": "Request Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))", "legendFormat": "requests/sec" } ] },

    { "id": 2, "title": "Error Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\", outcome=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[5m]))", "legendFormat": "error ratio" } ] },

    { "id": 3, "title": "P95 / P99 Latency", "type": "timeseries", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{service=~\"$service\"}[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=~\"$service\"}[5m])) by (le))", "legendFormat": "p99" }
      ] },

    { "id": 4, "title": "HTTP 4xx Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\", status=~\"4..\"}[1m]))", "legendFormat": "4xx/sec" } ] },

    { "id": 5, "title": "HTTP 5xx Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\", status=~\"5..\"}[1m]))", "legendFormat": "5xx/sec" } ] },

    { "id": 6, "title": "JVM Heap Used", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})", "legendFormat": "heap used" } ] },

    { "id": 7, "title": "Process CPU Usage", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [ { "expr": "process_cpu_usage{service=~\"$service\"}", "legendFormat": "CPU" } ] },

    { "id": 8, "title": "Live Threads", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "jvm_threads_live_threads{service=~\"$service\"}", "legendFormat": "threads" } ] },

    { "id": 9, "title": "GC Pause Rate", "type": "timeseries", "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[5m]))", "legendFormat": "GC pause/sec" } ] }
  ]
}
